# Token from @BotFather for @TeleStreamM3UBot
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token

# The "Move to Jellyfin" channel. Use the numeric id (starts with -100...) or @username.
# Numeric id is more reliable for private channels; get it by forwarding a
# channel message to @JsonDumpBot or similar, or by checking bot logs on first post.
CHANNEL_ID=-1001234567890

# Where the sqlite file lives (mounted volume in docker-compose)
DB_PATH=/data/telestream.db

HOST=0.0.0.0
PORT=8080

# Optional: your externally reachable base URL, used only to display the full
# playlist URL in /status. Leave unset to just show the relative path.
PUBLIC_URL=

LOG_LEVEL=INFO
PLAYLIST_NAME=Move to Jellyfin
